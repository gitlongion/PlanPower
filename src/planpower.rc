// ============================================================================
//  PlanPower - planpower.rc
//  只包含清单与版本信息；图标在运行时由 GDI 绘制，不引入 .ico 文件
// ============================================================================
#include <winuser.h>
#include <winver.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "planpower.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,2,0
PRODUCTVERSION  0,3,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "PlanPower"
            VALUE "FileDescription",  "PlanPower - 定时电源管理器（便携版）"
            VALUE "FileVersion",      "0.3.2.0"
            VALUE "InternalName",     "PlanPower"
            VALUE "OriginalFilename", "PlanPower.exe"
            VALUE "ProductName",      "PlanPower"
            VALUE "ProductVersion",   "0.3.2.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
